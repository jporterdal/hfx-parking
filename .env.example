# Database connection for the mirror, the served application and the tests.
# Copy this file to .env and fill it in. .env is never committed.
#
# These are the standard Postgres variables, so the same file drives psql and
# pg_isready. A variable already set in the shell or on the host wins over this file.
# The database tests create and drop a mirror_test_<pid> schema in PGDATABASE.

# Required: the server's host name or address, or a unix socket directory.
PGHOST=localhost

# Required: the role to connect as.
PGUSER=your_user

# Required: the database to connect to.
PGDATABASE=your_database

# Optional: leave commented out to use the default port, 5432.
# PGPORT=5432

# Optional: leave commented out for passwordless authentication or a ~/.pgpass entry.
# PGPASSWORD=your_password
